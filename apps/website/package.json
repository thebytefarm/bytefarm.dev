{
  "name": "@bytefarm/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ascii:preview": "ascii.rest play src/components/barn3-art.ts --watch",
    "ascii:export": "node src/components/generate-ascii.ts && oxfmt src/components/bytefarm-logo.json src/components/bytefarm-leaf.json",
    "ascii:logo": "ascii.rest play src/components/bytefarm-logo-art.ts --watch",
    "ascii:leaf": "ascii.rest play src/components/bytefarm-leaf-art.ts --watch",
    "clean": "rm -rf .output .vercel .turbo .tanstack dist node_modules"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.42",
    "@tanstack/react-start": "^1.168.61",
    "ascii.rest": "^0.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@bytefarm/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "nitro": "3.0.260903-beta",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
